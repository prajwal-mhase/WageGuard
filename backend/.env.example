# Leave blank for local SQLite. For Supabase Postgres, use the Session Pooler
# connection string from Supabase Project Settings > Database.
DATABASE_URL=

# Persistent local SQLite database when DATABASE_URL is blank.
DATABASE_PATH=./wageguard.db

# Change this outside local development.
JWT_SECRET=replace-with-a-long-random-secret

# Where the frontend runs, for CORS
FRONTEND_ORIGIN=http://localhost:5173
